{
  "name": "searchstax-search-lab",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "verify:pages": "node scripts/verify-pages.mjs",
    "test": "npm --prefix qa/regression test",
    "qa:release": "node qa/regression/release.cjs",
    "qa:preview": "node qa/regression/preview.cjs",
    "qa:sorting": "node qa/regression/sort-downloads.cjs",
    "qa:result-cards": "node qa/regression/result-cards.cjs",
    "qa:result-summary": "node qa/regression/result-summary.cjs"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "dependencies": {
    "fflate": "0.8.3"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "vite": "8.3.8"
  }
}
